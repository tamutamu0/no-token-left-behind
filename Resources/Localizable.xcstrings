          "stringUnit": {
            "state": "translated",
            "value": "公式ステータスライン"
          }
        }
      }
    },
    "Only ai-usage-snapshot-v2.json is updated. Other files are left alone.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ai-usage-snapshot-v2.jsonだけを更新します。他のファイルは変更しません。"
