            "state": "translated",
            "value": "取得を開始"
          }
        }
      }
    },
    "Start collecting to update Codex, Claude, Antigravity and Colab.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取得を開始すると、Codex・Claude・Antigravity・Colabの残量を更新します。"
