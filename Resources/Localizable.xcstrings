{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "%@ usage": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の残量"
          }
        }
      }
    },
    "%lld percent left, %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残り%lldパーセント、%@"
          }
        }
      }
    },
    "5-hour": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "5時間"
          }
        }
      }
    },
    "5-hour % left": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "5時間の残り %"
          }
        }
      }
    },
    "AI Usage": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AI残量"
          }
        }
      }
    },
    "AI Usage · DEMO": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AI残量 · DEMO"
          }
        }
      }
    },
    "Add it to your Home Screen": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホーム画面に1枚追加"
          }
        }
      }
    },
    "Appearance": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外観"
          }
        }
      }
    },
    "Auto": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動"
          }
        }
      }
    },
    "Awaiting refresh after reset": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回復後の再取得待ち"
          }
        }
      }
    },
    "Away from home, keep the Mac and iPhone on your private network (e.g. Tailscale). The Mac must be awake with the Mac app running.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外出先ではMacとiPhoneを同じ非公開ネットワーク（例: Tailscale）に接続してください。Macの起動とMacアプリの常駐が必要です。"
          }
        }
      }
    },
    "CLI via CodexBar": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CodexBar経由のCLI"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセル"
          }
        }
      }
    },
    "Can’t reach the Mac. Check that it is awake and on the same private network (e.g. Tailscale).": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macに接続できません。Macの起動状態とTailscaleを確認してください。"
          }
        }
      }
    },
    "Can’t save. Check the signing and App Group settings.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存できません。署名とApp Groupの設定を確認してください。"
          }
        }
      }
    },
    "Can’t start listening. Check the IP address and your private network (e.g. Tailscale).": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続を開始できません。IPとTailscaleを確認してください。"
          }
        }
      }
    },
    "Check the Scriptable iCloud folder or the existing export location. No settings were changed.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ScriptableのiCloudフォルダか既存の出力先を確認してください。設定は変更していません。"
          }
        }
      }
    },
    "Check the connection details. A private IP address and a 32-byte key are required.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続情報を確認してください。非公開IPと32バイトの接続キーが必要です。"
          }
        }
      }
    },
    "Check the numbers and that reset times are in the future.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "数値と未来の回復時刻を確認してください。"
          }
        }
      }
    },
    "Checks Codex, Claude, Antigravity and Colab every 10 minutes. Each needs its official CLI signed in.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex・Claude・Antigravity・Colabを10分ごとに照会します。各サービスの公式CLIへのログインが必要です。"
          }
        }
      }
    },
    "Choose Scriptable folder": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Scriptableフォルダを選ぶ"
          }
        }
      }
    },
    "Choose the Scriptable folder in iCloud Drive. Only usage numbers, reset times and sources are saved to ai-usage-snapshot-v2.json — never sign-in details.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive内のScriptableフォルダを選んでください。残量・回復時刻・取得元だけをai-usage-snapshot-v2.jsonへ保存します。ログイン情報は含みません。"
          }
        }
      }
    },
    "Claude, Codex and Antigravity 5-hour and weekly limits, plus Colab compute units, in one widget.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude・Codex・Antigravityの5時間と週間枠、Colabの残り計算ユニットを1枚に。"
          }
        }
      }
    },
    "Close": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じる"
          }
        }
      }
    },
    "Collecting and syncing every 10 minutes in the background.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックグラウンドで10分ごとに照会・同期します。"
          }
        }
      }
    },
    "Collection": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残量の取得"
          }
        }
      }
    },
    "Collection failed. Keeping the last values.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残量の照会に失敗しました。前回の値を保持しています。"
          }
        }
      }
    },
    "Compute units left": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残りの計算ユニット"
          }
        }
      }
    },
    "Compute units left (CU)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残りの計算ユニット（CU）"
          }
        }
      }
    },
    "Connect to Mac": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macと接続"
          }
        }
      }
    },
    "Connect to your Mac to show usage": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macと接続して残量を表示"
          }
        }
      }
    },
    "Connection details shown on the Mac": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macに表示された接続情報"
          }
        }
      }
    },
    "Connection key": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続キー"
          }
        }
      }
    },
    "Connection settings": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続設定"
          }
        }
      }
    },
    "Couldn’t export to iCloud. Check the chosen folder and iCloud Drive.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud出力に失敗しました。選択したフォルダとiCloud Driveの状態を確認してください。"
          }
        }
      }
    },
    "Couldn’t export to iCloud. Check the folder and its access permission.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud出力に失敗しました。同期先とアクセス許可を確認してください。"
          }
        }
      }
    },
    "Couldn’t load the preview.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレビューを読み込めませんでした。"
          }
        }
      }
    },
    "Couldn’t read the connection file.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続ファイルを読み込めません。"
          }
        }
      }
    },
    "Couldn’t save access to the chosen folder.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選んだフォルダのアクセス許可を保存できませんでした。"
          }
        }
      }
    },
    "Couldn’t save the connection file.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続ファイルを保存できません。"
          }
        }
      }
    },
    "DEMO · sample values": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DEMO · 架空の値"
          }
        }
      }
    },
    "Dark": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダーク"
          }
        }
      }
    },
    "Demo": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デモ"
          }
        }
      }
    },
    "Direct connection · native iPhone app": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直接接続 · ネイティブiPhoneアプリ版"
          }
        }
      }
    },
    "Disconnect": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続を解除"
          }
        }
      }
    },
    "Each Google quota is counted separately": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Googleの各枠は別の残量です"
          }
        }
      }
    },
    "Each Google quota is counted separately. Antigravity and Colab update once their official CLIs are set up on the Mac.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Googleの各枠は別の残量です。AntigravityとColabはMacで公式CLIを設定すると更新されます。"
          }
        }
      }
    },
    "Each row shows when it was observed": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残量の観測時刻は各行に表示"
          }
        }
      }
    },
    "Each service keeps its own observation time": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各サービスの取得時刻を保持"
          }
        }
      }
    },
    "Enter %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を入力"
          }
        }
      }
    },
    "Enter the values shown by the service. Leave a field blank if unknown.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公式画面の表示値を入力します。空欄は未取得として扱います。"
          }
        }
      }
    },
    "Exporting to: %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "出力先: %@"
          }
        }
      }
    },
    "Fetches usage numbers from your own Mac.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分のMacから残量だけを取得します。"
          }
        }
      }
    },
    "I know the 5-hour reset time": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "5時間の回復時刻が分かる"
          }
        }
      }
    },
    "I know the weekly reset time": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "週間の回復時刻が分かる"
          }
        }
      }
    },
    "Import the Mac’s connection file": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macの接続ファイルを読み込む"
          }
        }
      }
    },
    "Just the numbers, on your own iPhone.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残量だけを、自分のiPhoneへ。"
          }
        }
      }
    },
    "Large": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大"
          }
        }
      }
    },
    "Leave demo": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デモを終了"
          }
        }
      }
    },
    "Leave demo mode before collecting.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デモを終了してから取得してください。"
          }
        }
      }
    },
    "Left": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残り"
          }
        }
      }
    },
    "Left / resets in": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残り / 回復まで"
          }
        }
      }
    },
    "Light": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライト"
          }
        }
      }
    },
    "Mac offline · last values": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac未接続 · 前回の値"
          }
        }
      }
    },
    "Mac’s private IP (e.g. Tailscale 100.x.x.x)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macの非公開IP（例: Tailscaleの100.x.x.x）"
          }
        }
      }
    },
    "Manual": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手動"
          }
        }
      }
    },
    "Manual entry": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手動入力"
          }
        }
      }
    },
    "Manual · %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手動 · %@"
          }
        }
      }
    },
    "Medium": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中"
          }
        }
      }
    },
    "Needs sign-in or a source: %@. Keeping the last values.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン・取得元の確認待ち: %@。前回の値を保持しています。"
          }
        }
      }
    },
    "No data": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未取得"
          }
        }
      }
    },
    "No data / not in plan": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未取得 / 対象外"
          }
        }
      }
    },
    "No paid Apple Developer account needed. Only usage numbers are written to iCloud Drive on the same Apple Account, where the Scriptable widget reads them. Collection, iCloud sync and widget refresh each add some delay.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有料Apple Developer登録なしで使う経路です。同じApple AccountのiCloud Driveへ残量だけを出力し、iPhoneのScriptableウィジェットが読みます。Macの取得とiCloud同期、iOSの更新には遅延があります。"
          }
        }
      }
    },
    "Not set": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未設定"
          }
        }
      }
    },
    "Official Antigravity CLI": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公式Antigravity CLI"
          }
        }
      }
    },
